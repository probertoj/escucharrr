# bases de datos generadas
*.db
*.db-wal
*.db-shm
# config local del watcher (rutas propias de la máquina)
app/watch.json
app/obsidian.json
# credenciales de scrobbling (tokens/claves propias)
app/scrobble.json
app/.lastfm-token
# claves de APP cargadas por el lanzador (ESC_LASTFM_API_KEY/SECRET, etc.) — NUNCA al repo
escucharrr.secrets.cmd
# Spotify (app propia + token OAuth del usuario)
app/spotify.json
app/.spotify-token
# AcoustID (clave propia del usuario + ruta de fpcalc)
app/acoustid.json
# carátulas cacheadas en local (Cover Art Archive); se re-descargan con covers.js
app/cache/
# impulsos de convolución (WAV propios de la máquina del usuario)
app/impulses/
# copias de seguridad de la BD (locales)
app/backups/
# artefactos de recuperación (BD renombrada tras una corrupción)
app/*.corrupt-*
app/*.bak-*
# node
node_modules/
# log de errores del servidor (diagnóstico local; se regenera)
app/escucharrr-error.log
# empaquetado standalone: binarios portátiles (NO son fuente) + artefactos de SEA
node/
bin/
packaging/sea-prep.blob
escucharrr.exe
# artefactos de compilación del motor nativo (el código fuente sí se versiona)
engine/*.exe
engine/*.obj
engine/*.pdb
engine/*.ilk
engine/*.exp
engine/*.lib
app/liderarrr.json
app/plex.json
# Discogs (token personal opcional del usuario)
app/discogs.json
