@echo off
rem ============================================================================
rem  escucharrr - claves de APP (secretos locales, NO se versionan)
rem
rem  Copia este fichero a   escucharrr.secrets.cmd   (sin .example) y pega tus
rem  claves. El lanzador (escucharrr.cmd) lo carga al arrancar.
rem  escucharrr.secrets.cmd esta en .gitignore: nunca se sube al repo.
rem
rem  --- Last.fm «un clic» (estilo Spotify) ---------------------------------
rem  Con estas dos claves puestas, TODOS los usuarios conectan con solo pulsar
rem  «Conectar con Last.fm» y autorizar en la web de Last.fm: nadie tiene que
rem  crear su propia cuenta de API. Es UNA cuenta de API para la app entera.
rem
rem  Como obtenerlas (una sola vez):
rem    1) Entra en  https://www.last.fm/api/account/create
rem    2) Nombre: escucharrr (o el que quieras). Callback URL: dejalo EN BLANCO.
rem    3) Copia la «API key» y el «Shared secret» (de la MISMA app) aqui abajo.
rem ============================================================================
set "ESC_LASTFM_API_KEY=pega-aqui-tu-api-key"
set "ESC_LASTFM_API_SECRET=pega-aqui-tu-shared-secret"
